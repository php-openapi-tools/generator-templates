{
    "name": "openapi-tools/generator-templates",
    "description": "Templates generator",
    "license": "MIT",
    "authors": [
        {
            "name": "Cees-Jan Kiewiet",
            "email": "ceesjank@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "openapi-tools/contract": "^0.1.0",
        "openapi-tools/representation": "^0.1.0",
        "openapi-tools/utils": "^0.1.0",
        "wyrihaximus/simple-twig": "^2.1"
    },
    "require-dev": {
        "openapi-tools/configuration": "^0.1.0",
        "openapi-tools/gatherer": "^0.1.0",
        "openapi-tools/test-data": "dev-main",
        "wyrihaximus/async-test-utilities": "^13.5.2",
        "wyrihaximus/makefiles": "^0.14.6"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "OpenAPITools\\Generator\\Templates\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenAPITools\\Tests\\Generator\\Templates\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupol/composer-packages": true,
            "ergebnis/composer-normalize": true,
            "icanhazstring/composer-unused": true,
            "infection/extension-installer": true,
            "mindplay/composer-locator": true,
            "phpstan/extension-installer": true,
            "wyrihaximus/composer-update-bin-autoload-path": true,
            "wyrihaximus/makefiles": true,
            "wyrihaximus/test-utilities": true
        },
        "platform": {
            "php": "8.4.13"
        },
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": [
            "composer normalize",
            "make on-install-or-update || true"
        ],
        "post-update-cmd": [
            "composer normalize",
            "make on-install-or-update || true"
        ]
    }
}
